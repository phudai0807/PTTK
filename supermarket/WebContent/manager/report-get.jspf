<%@ page pageEncoding="UTF-8" import="java.sql.SQLException,vn.pttk.supermarket.dao.ManagerDAO1" %>
<%
    response.setHeader("Cache-Control", "no-store");
    if (!"GET".equals(request.getMethod()) && !"HEAD".equals(request.getMethod())) {
        response.setHeader("Allow", "GET, HEAD");
        response.sendError(405);
        return;
    }
    Object reportManagerId = session.getAttribute("managerId");
    try {
        if (!(reportManagerId instanceof Long)
                || !new ManagerDAO1().hasReportAccess((Long) reportManagerId)) {
            session.removeAttribute("managerId");
            session.removeAttribute("managerLogoutToken");
            response.sendRedirect(request.getContextPath() + "/quan-ly/dang-nhap");
            return;
        }
    } catch (SQLException exception) {
        application.log("Cannot verify report access.", exception);
        response.sendError(503, "Chưa thể kiểm tra quyền xem báo cáo. Vui lòng thử lại sau.");
        return;
    }
    request.setAttribute("reportManagerAuthorized", true);
%>
