<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <!-- Map the existing URLs directly to their JSP pages. -->
    <servlet>
        <servlet-name>gdMemberRegistration</servlet-name>
        <jsp-file>/customer/gdMemberRegistration1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>doMemberRegistration</servlet-name>
        <jsp-file>/customer/doMemberRegistration1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdStatisticsMenu</servlet-name>
        <jsp-file>/manager/gdStatisticsMenu1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdItemStatistics</servlet-name>
        <jsp-file>/manager/gdItemStatistics1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdItemDetails</servlet-name>
        <jsp-file>/manager/gdItemDetails1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdManagerLogin</servlet-name>
        <jsp-file>/manager/gdManagerLogin1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>doManagerLogin</servlet-name>
        <jsp-file>/manager/doManagerLogin1.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>doManagerLogout</servlet-name>
        <jsp-file>/manager/doManagerLogout1.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>gdMemberRegistration</servlet-name>
        <url-pattern>/dang-ky</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>doMemberRegistration</servlet-name>
        <url-pattern>/dang-ky/luu</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdStatisticsMenu</servlet-name>
        <url-pattern>/bao-cao</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdItemStatistics</servlet-name>
        <url-pattern>/thong-ke/hang-hoa</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdItemDetails</servlet-name>
        <url-pattern>/thong-ke/hang-hoa/chi-tiet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdManagerLogin</servlet-name>
        <url-pattern>/quan-ly/dang-nhap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>doManagerLogin</servlet-name>
        <url-pattern>/quan-ly/dang-nhap/xu-ly</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>doManagerLogout</servlet-name>
        <url-pattern>/quan-ly/dang-xuat</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list>
        <welcome-file>home.jsp</welcome-file>
    </welcome-file-list>
    <!-- Route browser requests through the servlet mappings above. -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Internal JSP paths</web-resource-name>
            <url-pattern>/customer/*</url-pattern>
            <url-pattern>/manager/*</url-pattern>
            <url-pattern>/common/*</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>
</web-app>
