<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <!-- Map the existing URLs directly to their JSP pages. -->
    <servlet>
        <servlet-name>gdDangKyThanhVien</servlet-name>
        <jsp-file>/WEB-INF/views/khachhang/gdDangKyThanhVien.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>doDangKyThanhVien</servlet-name>
        <jsp-file>/WEB-INF/views/khachhang/doDangKyThanhVien.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdChonThongKe</servlet-name>
        <jsp-file>/WEB-INF/views/quanly/gdChonThongKe.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdThongKeHangHoa</servlet-name>
        <jsp-file>/WEB-INF/views/quanly/gdThongKeHangHoa.jsp</jsp-file> 
    </servlet>
    <servlet>
        <servlet-name>gdChiTietHangHoa</servlet-name>
        <jsp-file>/WEB-INF/views/quanly/gdChiTietHangHoa.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>gdDangNhapQuanLy</servlet-name>
        <jsp-file>/WEB-INF/views/quanly/gdDangNhapQuanLy.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>doDangNhapQuanLy</servlet-name>
        <jsp-file>/WEB-INF/views/quanly/doDangNhapQuanLy.jsp</jsp-file>
    </servlet>
    <servlet>
        <servlet-name>doDangXuatQuanLy</servlet-name>
        <jsp-file>/WEB-INF/views/quanly/doDangXuatQuanLy.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>gdDangKyThanhVien</servlet-name>
        <url-pattern>/dang-ky</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>doDangKyThanhVien</servlet-name>
        <url-pattern>/dang-ky/luu</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdChonThongKe</servlet-name>
        <url-pattern>/bao-cao</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdThongKeHangHoa</servlet-name>
        <url-pattern>/thong-ke/hang-hoa</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdChiTietHangHoa</servlet-name>
        <url-pattern>/thong-ke/hang-hoa/chi-tiet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>gdDangNhapQuanLy</servlet-name>
        <url-pattern>/quan-ly/dang-nhap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>doDangNhapQuanLy</servlet-name>
        <url-pattern>/quan-ly/dang-nhap/xu-ly</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>doDangXuatQuanLy</servlet-name>
        <url-pattern>/quan-ly/dang-xuat</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
